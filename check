#!/usr/bin/env bash
set -euo pipefail

ASSIGNMENT=$(grep '^assignment:' .classroom50.yaml | sed -E 's/^assignment:[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/')
REPORT=$(mktemp)
check50 --local -o json --output-file "$REPORT" "OTH-Tech-Skills-Classroom50/technology-skills-checks/main/$ASSIGNMENT" > /dev/null 2>&1 || true

python3 - "$REPORT" <<'PYEOF'
import json
import sys

GREEN = "\033[92m"
RED = "\033[91m"
RESET = "\033[0m"

with open(sys.argv[1]) as f:
    data = json.load(f)

# check50 can fail before running any checks at all (e.g. a required file is
# missing) -- that shows up as an "error" key with no "results" key. Surface
# it instead of silently printing nothing.
if "error" in data:
    message = data["error"].get("value", "check50 could not run.")
    print(f"{RED}{message}{RESET}")
    sys.exit(1)

for r in data.get("results", []):
    name = r.get("description") or r.get("name")
    if r.get("passed"):
        print(f"{GREEN}{name}: PASSED ✓{RESET}")
    else:
        print(f"{RED}{name}: FAILED ✗{RESET}")
PYEOF

rm -f "$REPORT"
